# Default dev/prod with Vite/Vercel proxy:
VITE_API_BASE_URL=/api/admin

# Vite dev proxy target. Change this if backend dev port is not 3000.
VITE_BACKEND_PROXY_TARGET=http://localhost:3000

# If you want the browser to call backend directly instead of proxy:
# VITE_API_BASE_URL=http://localhost:3000/api/admin
# VITE_API_BASE_URL=https://api.example.com/api/admin
