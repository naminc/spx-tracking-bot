generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FinalStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

enum BroadcastStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
}

enum TrackingOrderActionType {
  ADD
  REMOVE
}

enum TrackingOrderActionSource {
  TELEGRAM
  ADMIN
}

model TrackingOrder {
  id                Int                      @id @default(autoincrement())
  trackingNumber    String                   @db.VarChar(64)
  telegramChatId    String                   @db.VarChar(64)
  userId            Int?
  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  note              String?                  @db.VarChar(512)
  currentStatus     String                   @db.VarChar(512)
  currentStatusCode String                   @db.VarChar(128)
  currentLocation   String?                  @db.VarChar(255)
  nextLocation      String?                  @db.VarChar(255)
  milestoneCode     String?                  @db.VarChar(128)
  milestoneName     String?                  @db.VarChar(255)
  lastEventTime     DateTime
  isCompleted       Boolean                  @default(false)
  finalStatus       FinalStatus              @default(PENDING)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  histories         TrackingHistory[]
  actionLogs        TrackingOrderActionLog[]

  @@unique([trackingNumber, telegramChatId])
  @@index([isCompleted])
  @@index([trackingNumber])
  @@index([userId])
}

model TrackingHistory {
  id                Int           @id @default(autoincrement())
  orderId           Int
  order             TrackingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingCode      String        @db.VarChar(128)
  trackingName      String?       @db.VarChar(255)
  status            String        @db.VarChar(512)
  location          String?       @db.VarChar(255)
  nextLocation      String?       @db.VarChar(255)
  description       String?       @db.VarChar(512)
  buyerDescription  String?       @db.VarChar(512)
  sellerDescription String?       @db.VarChar(512)
  milestoneCode     String?       @db.VarChar(128)
  milestoneName     String?       @db.VarChar(255)
  eventTime         DateTime
  rawData           Json
  createdAt         DateTime      @default(now())

  @@index([orderId])
  @@index([eventTime])
}

model User {
  id                      Int                      @id @default(autoincrement())
  telegramUserId          String                   @unique @db.VarChar(64)
  username                String?                  @db.VarChar(64)
  firstName               String?                  @db.VarChar(128)
  lastName                String?                  @db.VarChar(128)
  createdAt               DateTime                 @default(now())
  orders                  TrackingOrder[]
  broadcastRecipients     BroadcastRecipient[]
  trackingOrderActionLogs TrackingOrderActionLog[]

  @@index([username])
}

model TrackingOrderActionLog {
  id              Int                       @id @default(autoincrement())
  action          TrackingOrderActionType
  source          TrackingOrderActionSource
  trackingNumber  String                    @db.VarChar(64)
  telegramChatId  String?                   @db.VarChar(64)
  userId          Int?
  user            User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId         Int?
  order           TrackingOrder?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminTelegramId String?                   @db.VarChar(64)
  adminUsername   String?                   @db.VarChar(64)
  metadata        Json?
  createdAt       DateTime                  @default(now())

  @@index([action])
  @@index([source])
  @@index([trackingNumber])
  @@index([telegramChatId])
  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}

model Broadcast {
  id          Int                  @id @default(autoincrement())
  title       String?              @db.VarChar(255)
  message     String               @db.Text
  status      BroadcastStatus      @default(DRAFT)
  targetType  String               @db.VarChar(32)
  totalCount  Int                  @default(0)
  sentCount   Int                  @default(0)
  failedCount Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sentAt      DateTime?
  recipients  BroadcastRecipient[]

  @@index([status])
  @@index([createdAt])
}

model BroadcastRecipient {
  id             Int                      @id @default(autoincrement())
  broadcastId    Int
  broadcast      Broadcast                @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramUserId String                   @db.VarChar(64)
  status         BroadcastRecipientStatus @default(PENDING)
  errorMessage   String?                  @db.VarChar(512)
  sentAt         DateTime?
  createdAt      DateTime                 @default(now())

  @@index([broadcastId])
  @@index([userId])
  @@index([telegramUserId])
  @@index([status])
}

model AppSetting {
  id                 Int      @id
  adminContact       String   @db.VarChar(128)
  maintenanceEnabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
