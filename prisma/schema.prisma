generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum FinalStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

model TrackingOrder {
  id                Int               @id @default(autoincrement())
  trackingNumber    String            @db.VarChar(64)
  telegramChatId    String            @db.VarChar(64)
  userId            Int?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentStatus     String            @db.VarChar(512)
  currentStatusCode String            @db.VarChar(128)
  currentLocation   String?           @db.VarChar(255)
  nextLocation      String?           @db.VarChar(255)
  milestoneCode     String?           @db.VarChar(128)
  milestoneName     String?           @db.VarChar(255)
  lastEventTime     DateTime
  isCompleted       Boolean           @default(false)
  finalStatus       FinalStatus       @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  histories         TrackingHistory[]

  @@unique([trackingNumber, telegramChatId])
  @@index([isCompleted])
  @@index([trackingNumber])
  @@index([userId])
}

model TrackingHistory {
  id                Int           @id @default(autoincrement())
  orderId           Int
  order             TrackingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingCode      String        @db.VarChar(128)
  trackingName      String?       @db.VarChar(255)
  status            String        @db.VarChar(512)
  location          String?       @db.VarChar(255)
  nextLocation      String?       @db.VarChar(255)
  description       String?       @db.VarChar(512)
  buyerDescription  String?       @db.VarChar(512)
  sellerDescription String?       @db.VarChar(512)
  milestoneCode     String?       @db.VarChar(128)
  milestoneName     String?       @db.VarChar(255)
  eventTime         DateTime
  rawData           Json
  createdAt         DateTime      @default(now())

  @@index([orderId])
  @@index([eventTime])
}

model User {
  id             Int             @id @default(autoincrement())
  telegramUserId String          @unique @db.VarChar(64)
  username       String?         @db.VarChar(64)
  firstName      String?         @db.VarChar(128)
  lastName       String?         @db.VarChar(128)
  createdAt      DateTime        @default(now())
  orders         TrackingOrder[]

  @@index([username])
}

model AppSetting {
  id                 Int      @id
  adminContact       String   @db.VarChar(128)
  maintenanceEnabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
